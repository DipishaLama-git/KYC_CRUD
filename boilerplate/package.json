{
  "name": "kyc",
  "version": "1.0.0",
  "private": true,
  "description": "KYC monorepo (NestJS + TypeORM backend, React frontend)",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "only-allow pnpm",
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "only-allow": "^1.2.0"
  },
  "dependencies": {
    "@sbmdkl/nepali-date-converter": "^2.0.5",
    "multer": "^2.4.0"
  }
}
